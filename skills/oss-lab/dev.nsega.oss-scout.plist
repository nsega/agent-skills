<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.nsega.oss-scout</string>

  <!-- launchd starts with a bare environment: no homebrew PATH, no direnv.
       The command string supplies both, and the repo path is rewritten to
       the actual checkout by `make install-oss-lab` at copy time.
       Logs go through the shell redirect (launchd's Standard*Path keys
       cannot expand $HOME, and /tmp gets purged). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"; export OSS_LAB_STATE_DIR="${OSS_LAB_STATE_DIR:-$HOME/dev/oss-lab-state}"; mkdir -p "$HOME/Library/Logs"; exec ~/dev/agent-skills/skills/oss-lab/scripts/run-scout.sh >>"$HOME/Library/Logs/oss-scout.log" 2&gt;&amp;1</string>
  </array>

  <!-- Weekdays (Mon=1 .. Fri=5), hourly 09:00-18:00 -->
  <key>StartCalendarInterval</key>
